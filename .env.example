# FARMTECH SOLUTIONS — copie para .env e preencha somente os serviços utilizados.
# NUNCA faça commit do .env, chaves, senhas, tokens de sessão ou checkpoints privados.

# Oracle FIAP (Fase 3)
ORACLE_USER=RMxxxxxx
ORACLE_PASSWORD=sua_senha
ORACLE_HOST=oracle.fiap.com.br
ORACLE_PORT=1521
ORACLE_SERVICE=ORCL

# OpenWeather (Fase 2)
OPENWEATHER_API_KEY=sua_chave_aqui
CIDADE_MONITORADA=São Paulo

# YOLOv5 (Fase 6): caminhos relativos à raiz do repositório ou absolutos.
# Coloque os pesos do treino customizado, NÃO use yolov5s.pt como substituto.
YOLOV5_REPO=yolov5
YOLO_WEIGHTS=models/fase6_60_final_best.pt
YOLO_DEVICE=cpu

# AWS SNS (Fase 7) — configurar AWS Academy Learner Lab / CLI / Role.
# Credenciais podem ficar nas variáveis de ambiente do SO ou ~/.aws/credentials.
# Se usar .env, preencher com valores REAIS e token atual do Learner Lab.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_access_key
AWS_SECRET_ACCESS_KEY=sua_secret_key
AWS_SESSION_TOKEN=seu_token_se_usar_learner_lab
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:FarmTechAlertas
# O destino e-mail/SMS é definido pelas subscriptions confirmadas no tópico SNS.
# EMAIL_ALERTA_DESTINO não é usado para enviar diretamente.
EMAIL_ALERTA_DESTINO=gestor@farmtech.com.br